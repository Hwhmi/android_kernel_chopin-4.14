From c4e7a91d6b82f5043a9d1e8c6b70f2a5d83e9b14c60 Mon Sep 17 00:00:00 2001
From: dev <dev@local>
Date: Wed, 11 Nov 2026 13:48:00 +0800
Subject: [PATCH] sched: schedutil: apply the chopin frame-pacing rate limits

The boot-ok 4.14.357 reference tunes schedutil for the 120Hz panel:
up_rate_limit_us = 500 (ramp up as soon as load appears) and
down_rate_limit_us = 8000 (~one frame at 120Hz, so the governor cannot
downclock in the middle of a frame). Our 4.14.186 tree uses the
symmetric cpufreq_policy_transition_delay_us (~1000us) for both.

Set both values in sugov_tunables_alloc() and drop the transition_delay
override in sugov_init(), which would otherwise overwrite them and make
this tuning a no-op. The reference also carries a kobject-release
refactor of sugov_tunables_free() from 4.14 stable; that is a separate
lifetime fix and is deliberately not included here.

Verified: aarch64-linux-gnu cross-build of cpufreq_schedutil.o clean,
no new warnings.

---
 kernel/sched/cpufreq_schedutil.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
@@ -759,6 +759,15 @@
 
 	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
 	if (tunables) {
+		/*
+		 * chopin: frame pacing tuning for the 120Hz panel.
+		 * Ramp up within 500us so a new frame's load is met immediately,
+		 * and hold the frequency for ~8ms (one frame at 120Hz) before
+		 * downclocking, so the governor cannot drop the frequency in the
+		 * middle of a frame.
+		 */
+		tunables->up_rate_limit_us = 500;
+		tunables->down_rate_limit_us = 8000;
 		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
 		if (!have_governor_per_policy())
 			global_tunables = tunables;
@@ -816,9 +825,6 @@
 		goto stop_kthread;
 	}
 
-	tunables->up_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
-	tunables->down_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
-
 	policy->governor_data = sg_policy;
 	sg_policy->tunables = tunables;
 
-- 
2.43.0

