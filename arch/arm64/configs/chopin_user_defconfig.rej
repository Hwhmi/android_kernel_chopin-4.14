--- arch/arm64/configs/chopin_user_defconfig
+++ arch/arm64/configs/chopin_user_defconfig
@@ -546,3 +546,13 @@ CONFIG_LOCALVERSION="-g92fb10bdfUa"
 # CONFIG_LOCALVERSION_AUTO is not set
 # EROFS support (for future erofs ROM builds)
 CONFIG_EROFS_FS=y
+# Android 15 compatibility: vendor hooks, cgroup freezer, PSI
+CONFIG_ANDROID_VENDOR_HOOKS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_PSI=y
+# CONFIG_PSI_DEFAULT_DISABLED is not set
+# BBR2 TCP congestion control
+CONFIG_TCP_CONG_ADVANCED=y
+CONFIG_TCP_CONG_BBR=y
+CONFIG_TCP_CONG_BBR2=y
+CONFIG_DEFAULT_BBR2=y
